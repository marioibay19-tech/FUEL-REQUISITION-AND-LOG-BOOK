# FUELTRACK environment configuration — copy to server/.env and fill in.
# Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://fueltrack:CHANGE_ME@localhost:5432/fueltrack?schema=public"
# Separate database used by the automated tests (it is wiped on every run)
TEST_DATABASE_URL="postgresql://fueltrack:CHANGE_ME@localhost:5432/fueltrack_test?schema=public"

# Long random string (e.g. `openssl rand -hex 32`). Required in production.
SESSION_SECRET="replace-with-a-long-random-string"
# Session idle lifetime in minutes
SESSION_TTL_MINUTES=480

NODE_ENV=development
PORT=4000
# Origin the browser uses to reach the app (used for cookie/CSRF checks)
APP_ORIGIN="http://localhost:5173"
# Set to true when served over HTTPS behind a reverse proxy
TRUST_PROXY=false

# Where uploaded receipts and supporting documents are stored
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# Initial administrator created by `npm run db:seed` (production seed only
# creates this account and reference data; demo data is skipped).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD="ChangeMe!2026"
# Set to true to load sample vehicles, users and transactions
SEED_DEMO_DATA=true
